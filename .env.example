# ==============================================================================
# RHOV Sphere Portal & OpenShift Virtualization Environment Variables
# ==============================================================================
# 예시: cp .env.example .env && ./setup-env.sh --render
# ==============================================================================

# 1. OpenShift / Kubernetes Cluster & Portal API Authentication
export OPENSHIFT_API_URL="https://api.rhov-cluster.example.local:6443"
export OPENSHIFT_TOKEN="<REPLACE_WITH_SERVICEACCOUNT_BEARER_TOKEN>"
export PORT="4000"
export COLLECTOR_PORT="4001"
export THANOS_HOST="thanos-querier.openshift-monitoring.svc"
export THANOS_PORT="9091"

# 2. Cluster & Ingress Base Domain Configuration
export BASE_DOMAIN="example.local"
export CLUSTER_NAME="rhov-cluster"
export APPS_DOMAIN="apps.${CLUSTER_NAME}.${BASE_DOMAIN}"

# 3. Infrastructure & Virtualization (vSphere / NFS)
export VCENTER_SERVER="vcenter.example.internal"
export VSPHERE_NETWORK="VM_Network"
export API_VIP="192.168.100.200"
export INGRESS_VIP="192.168.100.201"
export MACHINE_NETWORK_CIDR="192.168.100.0/24"
export NFS_SERVER="192.168.100.195"
export NFS_PATH="/nfs_share/rhov-storage"
export VM_PASSWORD="<REPLACE_WITH_VM_PASSWORD>"
